{
  "$comment": "GENERATED by npm run schema; do not edit.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^src-[a-z0-9]+(?:-[a-z0-9]+)*-\\d{8}-\\d{2}$"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "government",
        "court",
        "news"
      ]
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "publisher_org_id": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "pattern": "^org-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "outlet_id": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "authors": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "family": {
            "type": "string",
            "minLength": 1
          },
          "given": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "family",
          "given"
        ],
        "additionalProperties": false
      }
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "date_published": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      ]
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "archive_url": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    },
    "archive_status": {
      "default": "ok",
      "type": "string",
      "enum": [
        "ok",
        "failed",
        "blocked"
      ]
    },
    "text_file": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "accessed": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      ]
    },
    "report_number": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "link_status": {
      "default": "ok",
      "type": "string",
      "enum": [
        "ok",
        "broken",
        "redirected"
      ]
    }
  },
  "required": [
    "id",
    "source_type",
    "publisher",
    "title",
    "date_published",
    "url",
    "accessed"
  ],
  "additionalProperties": false
}
