---
import Base from "../layouts/Base.astro";
import { getData } from "../lib/data";
import { eventStatus } from "../lib/derive";

const data = getData();
const byStatus = { pending: 0, partially_resolved: 0, resolved: 0 };
for (const e of data.events) byStatus[eventStatus(e)] += 1;
---
<Base title="Federal Fraud and Public Corruption Tracker">
  <h1>Federal Fraud and Public Corruption Tracker</h1>
  <p class="summary">A public, fact-first record of public corruption cases involving federal officials from 2016 to the present. Every case rests on an official government action, every number links to its source, and status is tracked for each person separately.</p>
  <div class="table-wrap">
    <table>
      <caption>Records in the database</caption>
      <tbody>
        <tr><th scope="row">Cases</th><td><a href="/cases/">{data.events.length}</a></td></tr>
        <tr><th scope="row">Cases pending</th><td>{byStatus.pending}</td></tr>
        <tr><th scope="row">Cases partially resolved</th><td>{byStatus.partially_resolved}</td></tr>
        <tr><th scope="row">Cases resolved</th><td>{byStatus.resolved}</td></tr>
        <tr><th scope="row">People</th><td>{data.people.length}</td></tr>
        <tr><th scope="row">Organizations and agencies</th><td>{data.organizations.length}</td></tr>
        <tr><th scope="row">Government sources</th><td>{data.sources.length}</td></tr>
      </tbody>
    </table>
  </div>
  <p class="notice">Counts reflect official actions, not the total amount of corruption. Changes over time can reflect enforcement priorities, staffing, and policy, not only changes in misconduct. Recent years are incomplete: cases are often charged years after the conduct.</p>
</Base>
