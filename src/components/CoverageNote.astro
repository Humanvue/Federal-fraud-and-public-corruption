---
import { getData } from "../lib/data";
import { coverageRows } from "../lib/coverage";
const data = getData();
const n = data.events.length;
const rows = coverageRows(data).filter((r) => r.national !== null);
const ours = rows.reduce((a, r) => a + r.ours, 0);
const national = rows.reduce((a, r) => a + (r.national ?? 0), 0);
const span = rows.length ? `${rows[0].year} through ${rows[rows.length - 1].year}` : "";
---
<p class="notice">
  This database holds {n} cases. It is not a complete record of federal public corruption cases.
  {national > 0 && <>From {span}, the Justice Department reports {national.toLocaleString("en-US")} federal officials charged with public corruption nationwide; this database includes {ours} of them. <a href="/coverage/">See coverage by year.</a> </>}
  Counts reflect official actions, not the total amount of corruption, and recent years are incomplete because cases are often charged years after the conduct.
</p>
